#!/bin/sh
":" //# comment; exec /usr/bin/env node --harmony "$0" "$@"
import {proxyChildProcess, setCursorVisibility} from '#utils/cliFunctions'
import {exit} from 'node:process'
import {resolve} from "path";
import {dirnameFromMeta, readJsonFile} from "#core/FS/utils";
import {GLOBAL_CONFIG_FILEPATH} from "#lib/defs";
import {ParsedGlobalConfig} from "#config/ParsedGlobalConfig";
import {createComputedLogger} from "#logger/ComputedLogger";

const exitCode = await proxyChildProcess(createComputedLogger(
  new ParsedGlobalConfig(readJsonFile(GLOBAL_CONFIG_FILEPATH), GLOBAL_CONFIG_FILEPATH)
), resolve(dirnameFromMeta(import.meta), '../dist/client.js'))

setCursorVisibility(true)
exit(exitCode)
